---
const { title = 'De Bon' } = Astro.props;

import { createClient } from '@sanity/client';

const sanityClient = createClient({
  projectId: import.meta.env.SANITY_PROJECT_ID,
  dataset: import.meta.env.SANITY_DATASET,
  apiVersion: '2024-01-01',
  token: import.meta.env.SANITY_API_TOKEN,
  useCdn: true,
});

const eerdereScans = await sanityClient.fetch(`
  *[_type == "scan"] | order(gescandOp desc)[0...5] {
    url,
    verdict,
    gescandOp
  }
`);

function toonDomein(url) {
  return url.replace(/^https?:\/\//, '').replace(/\/$/, '');
}
---
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <strong>De Bon</strong>
      <span>gemaakt door bebr.studio</span>
    </header>

    <div class="layout">
      <main>
        <slot />
      </main>
        <aside aria-label="Eerdere scans">
        <h2>Eerdere scans</h2>
        <ul>
            {eerdereScans.map((scan) => (
                <li>
                <div>
                    <strong>{toonDomein(scan.url)}</strong>
                    <span class="datum">{new Date(scan.gescandOp).toLocaleDateString('nl-NL')}</span>
                </div>
                <span class="badge" data-status={scan.verdict}>{scan.verdict}</span>
                </li>
            ))}
        </ul>
        </aside>
    </div>
  </body>
</html>

<style>
  /* Mobile first: dit is de basisstijl, geldt voor alle schermen */
  .layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1rem;
  }

  header {
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }

  aside {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 8px;
  }

    li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e0e0e0;
    gap: 0.5rem;
    }

    li > div {
    min-width: 0; /* nodig zodat text-overflow werkt binnen flexbox */
    overflow: hidden;
    }

    li strong {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    }


    .datum {
    display: block;
    font-size: 0.8rem;
    color: #888;
    }

    .badge {
    flex-shrink: 0; /* voorkomt dat de badge kleiner wordt geknepen */
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: capitalize;
    }

    .badge[data-status='goedgekeurd'] {
    background: #dff3e4;
    color: #2f7a3f;
    }

    .badge[data-status='afgekeurd'] {
    background: #fbe0de;
    color: #b23a2e;
    }

    .badge[data-status='verbeteringen'] {
    background: #fdecd2;
    color: #b8710f;
    }

  /* Vanaf hier: verbreding voor grotere schermen */
  @media (min-width: 768px) {
    .layout {
      display: grid;
      grid-template-columns: 1fr 280px;
    }

    header {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>