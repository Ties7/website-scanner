---
import Layout from '../layouts/Layout.astro';
import { scanWebsite, bepaalOordeel } from '../lib/scanner.js';

let resultaat = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const url = formData.get('url');
  resultaat = await scanWebsite(url);
}
---

<Layout title="De Bon — Horeca Website Scanner">
  <form method="POST">
    <input type="text" name="url" placeholder="bijv. cafegeorge.nl" required />
    <button type="submit">Scan</button>
  </form>

	{resultaat && (
		<div class="rapport-kop">
		<h2>{resultaat.url}</h2>
			<div class="cirkels">
			<div class="cirkel-met-label">
				<div class="score-cirkel" data-status={bepaalOordeel(resultaat.seoScore, resultaat.seoScore)} style={`--percentage: ${resultaat.seoScore}`}>
				<span>{resultaat.seoScore}</span>
				</div>
				<span class="cirkel-label">SEO</span>
			</div>

			<div class="cirkel-met-label">
				<div class="score-cirkel" data-status={bepaalOordeel(resultaat.performanceScore, resultaat.performanceScore)} style={`--percentage: ${resultaat.performanceScore}`}>
				<span>{resultaat.performanceScore}</span>
				</div>
				<span class="cirkel-label">Performance</span>
			</div>
			</div>
		</div>

		<div class="ai-review">
			<h3>AI-samenvatting</h3>
			<p>{resultaat.aiReview.samenvatting}</p>
		</div>

		<div class="verbeterpunten">
			<h3>Verbeterpunten</h3>
			<ul>
				{resultaat.aiReview.verbeterpunten.map((punt) => (
				<li data-urgentie={punt.urgentie}>{punt.tekst}</li>
				))}
			</ul>
		</div>

		<div class="eindoordeel" data-status={resultaat.verdict}>
			<div>
				<span class="eindoordeel-label">Eindoordeel</span>
				<strong class="eindoordeel-tekst">{resultaat.verdict}</strong>
			</div>
			<p class="eindoordeel-toelichting">
				{resultaat.eindoordeelToelichting}
			</p>
		</div>
	)}
</Layout>

<style>
	/* Mobile first: gestapeld als basis */
	.rapport-kop {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	/* Vanaf hier: naast elkaar voor grotere schermen */
	@media (min-width: 768px) {
		.rapport-kop {
			flex-direction: row;
			gap: 2rem;
			align-items: center;
		}
	}

	.score-cirkel {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: bold;
		background: conic-gradient(
			var(--kleur) calc(var(--percentage) * 1%),
			#e0e0e0 0
		);
	}

	.score-cirkel[data-status='goedgekeurd'] {
		--kleur: #2f7a3f;
	}

	.score-cirkel[data-status='verbeteringen'] {
		--kleur: #b8710f;
	}

	.score-cirkel[data-status='afgekeurd'] {
		--kleur: #b23a2e;
	}

	.cirkels {
		display: flex;
		gap: 0.75rem;
	}

	.score-cirkel span {
		background: white;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cirkel-met-label {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
	}

	.cirkel-label {
		font-size: 0.75rem;
		color: #888;
	}

	li[data-urgentie='laag'] {
		color: #2f7a3f;
	}

	li[data-urgentie='gemiddeld'] {
		color: #b8710f;
	}

	li[data-urgentie='hoog'] {
		color: #b23a2e;
	}

	.eindoordeel {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		border-radius: 8px;
		margin-top: 1rem;
	}

	.eindoordeel-label {
		display: block;
		font-size: 0.8rem;
		color: #888;
	}

	.eindoordeel-tekst {
		font-size: 1.5rem;
		text-transform: uppercase;
	}

	.eindoordeel-toelichting {
		font-size: 0.85rem;
		margin: 0;
	}

	.eindoordeel[data-status='goedgekeurd'] {
		background: #dff3e4;
	}

	.eindoordeel[data-status='verbeteringen'] {
		background: #fdecd2;
	}

	.eindoordeel[data-status='afgekeurd'] {
		background: #fbe0de;
	}
</style>